{
  "definition": "Es el sistema integral que reúne, organiza y armoniza toda la información existente sobre un municipio proveniente de fuentes internacionales, nacionales, departamentales y municipales para ofrecer una visión completa, coherente y actualizada de su realidad en cada sector. Su propósito es totalizar y consolidar la data dispersa, garantizar su calidad y convertirla en insumo estratégico para la planificación, la toma de decisiones y la gestión pública basada en evidencia.",
  "principles": [
    {
      "title": "Priorizar la información crítica para la toma de decisiones",
      "text": "Concentrar el esfuerzo en variables esenciales cuando la información es limitada para construir una base mínima confiable."
    },
    {
      "title": "Integrar fuentes diversas y de fácil acceso",
      "text": "Articular fuentes internacionales, nacionales, departamentales, municipales y comunitarias aunque provengan de formatos distintos."
    },
    {
      "title": "Validar la información con actores del territorio",
      "text": "Usar verificación con líderes, veredas, sectores productivos e instituciones locales para asegurar pertinencia y precisión."
    },
    {
      "title": "Documentar y estandarizar cada dato recolectado",
      "text": "Registrar, clasificar y actualizar con protocolos simples que eviten pérdida de información y permitan crecer el sistema."
    },
    {
      "title": "Construir capacidades locales para la gestión de información",
      "text": "Formar equipos municipales y comunitarios en alfabetización de datos, herramientas e indicadores para sostener el sistema."
    }
  ],
