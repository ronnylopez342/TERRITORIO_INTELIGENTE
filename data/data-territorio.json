  "glossary": [
    {
      "term": "Indicador",
      "definition": "Medida cuantitativa o cualitativa usada para observar el estado o cambio de una variable.",
      "source": "DEMO · Metodología TI"
    },
    {
      "term": "Línea base",
      "definition": "Valor inicial de referencia frente al cual se compara el avance de una meta.",
      "source": "DEMO · Metodología TI"
    },
    {
      "term": "Meta resultado",
      "definition": "Resultado esperado al final de un periodo de gobierno, medido mediante uno o más indicadores.",
      "source": "DEMO · Planeación"
    },
    {
      "term": "Georreferenciación",
      "definition": "Asociación de información a una ubicación espacial para analizar su distribución territorial.",
      "source": "DEMO · Data Territorio"
    },
    {
      "term": "Trazabilidad",
      "definition": "Capacidad de seguir el vínculo entre dato, análisis, decisión, ejecución y resultado.",
      "source": "DEMO · Gobernanza"
    },
    {
      "term": "Alerta temprana",
      "definition": "Señal generada antes de que un riesgo se convierta en incumplimiento crítico.",
      "source": "DEMO · Cumplimiento"
    },
    {
      "term": "MIPG",
      "definition": "Marco de gestión institucional usado aquí solo como referencia conceptual para la demo.",
      "source": "DEMO · Institucional"
    }
  ],
